+
+/**
+ * The "Allow OAuth apps" field: one app per line, its client_id URL then the
+ * atproto scopes the VM's workload identity may approve as the signed-in
+ * account (spaces or commas between them; none means atproto). A * in the
+ * client_id matches a keyed client_id. Full-access and rbac scopes are refused
+ * here as the requester refuses them (docs/pds/oauth-wid.md of
+ * socialweb-computer-kcp).
+ */
+export function parseOAuthClients(text) {
+  const out = [];
+  const seen = new Set();
+  for (const raw of String(text ?? "").split("\n")) {
+    const line = raw.trim();
+    if (!line || line.startsWith("#")) continue;
+    const [clientId, ...rest] = line.split(/[\s,]+/).filter(Boolean);
+    let url;
+    try {
+      url = new URL(clientId.replaceAll("*", "x"));
+    } catch {
+      throw new Error(`OAuth app ${clientId}: not a URL`);
+    }
+    if (url.protocol !== "https:") throw new Error(`OAuth app ${clientId}: not an https client_id`);
+    if (seen.has(clientId)) throw new Error(`OAuth app ${clientId}: listed twice`);
+    seen.add(clientId);
+    const scopes = rest.length > 0 ? [...new Set(rest)] : ["atproto"];
+    for (const scope of scopes) {
+      if (scope.startsWith("transition:") || scope.startsWith("repo:*") || scope.startsWith("repo:com.fedproxy.rbac")) {
+        throw new Error(`OAuth app ${clientId}: ${scope} is a scope a workload may not approve`);
+      }
+    }
+    out.push({ clientId, scopes });
+  }
+  return out;
+}
diff --git a/scripts/browser/vmshell_test.js b/scripts/browser/vmshell_test.js
index d3607dac3..1b77f61b5 100644
--- a/scripts/browser/vmshell_test.js
+++ b/scripts/browser/vmshell_test.js
@@ -10,6 +10,7 @@ import {
   finishedInfraContracts,
   fnv1a64,
   infraContract,
+  parseOAuthClients,
   infraRecordBinding,
   infraRecordStale,
   r2StartShown,
@@ -962,3 +963,31 @@ Deno.test("beforeunload: warns while release work runs in this tab", async () =>
   assert(/const seen = contracts\.map\(\(c\) => vmshell\.withReleaseSent\(c, computeReleaseAsked\.get\(c\?\.name\)\)\)/.test(app),
     "over the contracts as this tab sees them (a Release sent, not yet copied)");
 });
+
+Deno.test("parseOAuthClients: one app per line, scopes after it, atproto by default", () => {
+  const out = parseOAuthClients(
+    "https://irc.fedfork.com/oauth/client-metadata* atproto,repo:com.vibescrobble.scrobble?action=create\n\n# note\nhttps://app.example/client.json",
+  );
+  if (out.length !== 2) throw new Error(JSON.stringify(out));
+  if (out[0].clientId !== "https://irc.fedfork.com/oauth/client-metadata*") throw new Error(out[0].clientId);
+  if (out[0].scopes.join(" ") !== "atproto repo:com.vibescrobble.scrobble?action=create") throw new Error(out[0].scopes.join(" "));
+  if (out[1].scopes.join(" ") !== "atproto") throw new Error(out[1].scopes.join(" "));
+});
+
+Deno.test("parseOAuthClients: refuses http, full access and rbac scopes", () => {
+  for (const bad of ["http://app.example/c.json", "https://app.example/c.json transition:generic", "https://app.example/c.json repo:com.fedproxy.rbac"]) {
+    let threw = false;
+    try {
+      parseOAuthClients(bad);
+    } catch {
+      threw = true;
+    }
+    if (!threw) throw new Error(`accepted ${bad}`);
+  }
+});
+
+Deno.test("infraContract: oauthClients reach the contract template with a secrets bundle", () => {
+  const out = infraContract({ infra: "s1", short: "vmshell-abc", oauthClients: [{ clientId: "https://app.example/c.json", scopes: ["atproto"] }] });
+  if (out.contract.oauthClients?.[0]?.clientId !== "https://app.example/c.json") throw new Error(JSON.stringify(out.contract));
+  if (!out.secret) throw new Error("no secrets entry for the oauth-wid.json bundle");
+});
