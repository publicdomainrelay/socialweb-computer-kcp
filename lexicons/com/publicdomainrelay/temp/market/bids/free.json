{
  "lexicon": 1,
  "id": "com.publicdomainrelay.temp.market.bids.free",
  "description": "Bid terms: the bidder provides the payload at no cost.",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["reason", "signatures"],
        "properties": {
          "reason": { "type": "string" },
          "cost": { "type": "integer", "minimum": 0 },
          "createdAt": { "type": "string", "format": "datetime" },
          "signatures": { "type": "ref", "ref": "network.attested.signature#signatures" }
        }
      }
    }
  }
}
