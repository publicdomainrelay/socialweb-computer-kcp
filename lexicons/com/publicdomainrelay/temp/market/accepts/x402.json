{
  "lexicon": 1,
  "id": "com.publicdomainrelay.temp.market.accepts.x402",
  "description": "Accept terms for a market.bids.x402 bid; payload references the payment.",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["bid", "signatures"],
        "properties": {
          "bid": { "type": "ref", "ref": "com.atproto.repo.strongRef", "description": "The accepted market.bid." },
          "payload": { "type": "ref", "ref": "com.atproto.repo.strongRef" },
          "createdAt": { "type": "string", "format": "datetime" },
          "signatures": { "type": "ref", "ref": "network.attested.signature#signatures" }
        }
      }
    }
  }
}
