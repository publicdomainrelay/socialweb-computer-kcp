{
  "lexicon": 1,
  "id": "com.publicdomainrelay.temp.compute.events.vm.onNetwork",
  "description": "The bidder reports the VM's network address; sent as the payload of a market.event.",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["createdAt"],
        "properties": {
          "address": { "type": "string", "description": "The VM's address on the tenant network." },
          "createdAt": { "type": "string", "format": "datetime" },
          "signatures": { "type": "ref", "ref": "network.attested.signature#signatures" }
        }
      }
    }
  }
}
