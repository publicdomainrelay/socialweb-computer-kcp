[
  {
    "apiVersion": "v1",
    "kind": "Namespace",
    "metadata": {
      "name": "staging",
      "annotations": {
        "staging/ports": "{\"plc\":2582,\"pds\":80,\"relay\":2470,\"jetstream\":6008}",
        "staging/health": "{\"plc\":\"/_health\",\"pds\":\"/xrpc/_health\",\"relay\":\"/xrpc/_health\",\"jetstream\":\"/xrpc/_health\"}"
      }
    }
  },
  {
    "apiVersion": "v1",
    "kind": "Secret",
    "metadata": { "name": "staging", "namespace": "staging" },
    "type": "Opaque",
    "stringData": {
      "postgres-password": "{{secret:postgres_password}}",
      "plc-db-creds": "{\"username\":\"postgres\",\"password\":\"{{secret:postgres_password}}\",\"host\":\"127.0.0.1\",\"port\":\"5432\",\"database\":\"postgres\"}",
      "pds-admin-password": "{{secret:pds_admin_password}}",
      "pds-jwt-secret": "{{secret:pds_jwt_secret}}",
      "pds-plc-rotation-key": "{{secret:pds_plc_rotation_key}}",
      "relay-admin-password": "{{secret:relay_admin_password}}"
    }
  },
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": { "name": "vip", "namespace": "staging" },
    "spec": {
      "replicas": 1,
      "strategy": { "type": "Recreate" },
      "selector": { "matchLabels": { "app": "vip" } },
      "template": {
        "metadata": { "labels": { "app": "vip", "staging/services": "true", "staging/tag": "1.37" } },
        "spec": {
          "affinity": { "podAffinity": { "requiredDuringSchedulingIgnoredDuringExecution": [ { "labelSelector": { "matchLabels": { "staging/services": "true" } }, "topologyKey": "kubernetes.io/hostname" } ] } },
          "hostNetwork": true,
          "terminationGracePeriodSeconds": 5,
          "containers": [
            {
              "name": "vip",
              "image": "docker.io/library/busybox@sha256:a7dbc319b1438115a207e11930dc4bb3e643dcb3ec0bdd694bb36cd8fad289ec",
              "command": ["sh", "-c", "ip addr add 10.45.0.1/32 dev lo 2>/dev/null; exec sleep 2147483647"],
              "securityContext": { "capabilities": { "add": ["NET_ADMIN"] } },
              "lifecycle": { "preStop": { "exec": { "command": ["ip", "addr", "del", "10.45.0.1/32", "dev", "lo"] } } },
              "readinessProbe": { "exec": { "command": ["sh", "-c", "ip -4 addr show dev lo | grep -q ' 10.45.0.1/32'"] }, "periodSeconds": 5 },
              "resources": { "requests": { "cpu": "10m", "memory": "16Mi" } }
            }
          ]
        }
      }
    }
  },
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": { "name": "plc", "namespace": "staging" },
    "spec": {
      "replicas": 1,
      "strategy": { "type": "Recreate" },
      "selector": { "matchLabels": { "app": "plc" } },
      "template": {
        "metadata": { "labels": { "app": "plc", "staging/services": "true", "staging/tag": "plc-f2ab7516bac5bc0f3f86842fa94e996bd1b3815b", "staging/tag-postgres": "18-alpine" } },
        "spec": {
          "affinity": { "podAffinity": { "requiredDuringSchedulingIgnoredDuringExecution": [ { "labelSelector": { "matchLabels": { "staging/services": "true" } }, "topologyKey": "kubernetes.io/hostname" } ] } },
          "hostNetwork": true,
          "initContainers": [
            {
              "name": "postgres",
              "image": "docker.io/library/postgres@sha256:1018733457011bf88d81db98cf43aac6d5150afc18787dbe204771fedf80ff95",
              "restartPolicy": "Always",
              "args": ["-c", "listen_addresses=127.0.0.1"],
              "env": [ { "name": "POSTGRES_PASSWORD", "valueFrom": { "secretKeyRef": { "name": "staging", "key": "postgres-password" } } } ],
              "startupProbe": { "exec": { "command": ["pg_isready", "-h", "127.0.0.1", "-U", "postgres"] }, "periodSeconds": 2, "failureThreshold": 60 },
              "volumeMounts": [ { "name": "pgdata", "mountPath": "/var/lib/postgresql" } ],
              "resources": { "requests": { "cpu": "100m", "memory": "256Mi" } }
            }
          ],
          "containers": [
            {
              "name": "plc",
              "image": "ghcr.io/bluesky-social/did-method-plc@sha256:c78a4e972c356610851078757f1ebe4f359634c24909209d740c1dbe74395b83",
              "env": [
                { "name": "PORT", "value": "2582" },
                { "name": "DB_CREDS_JSON", "valueFrom": { "secretKeyRef": { "name": "staging", "key": "plc-db-creds" } } },
                { "name": "DB_MIGRATE_CREDS_JSON", "valueFrom": { "secretKeyRef": { "name": "staging", "key": "plc-db-creds" } } }
              ],
              "readinessProbe": { "httpGet": { "path": "/_health", "port": 2582 }, "periodSeconds": 5 },
              "resources": { "requests": { "cpu": "100m", "memory": "256Mi" } }
            }
          ],
          "volumes": [ { "name": "pgdata", "emptyDir": {} } ]
        }
      }
    }
  },
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": { "name": "pds", "namespace": "staging" },
    "spec": {
      "replicas": 1,
      "strategy": { "type": "Recreate" },
      "selector": { "matchLabels": { "app": "pds" } },
      "template": {
        "metadata": { "labels": { "app": "pds", "staging/services": "true", "staging/tag": "0.4.5051" } },
        "spec": {
          "affinity": { "podAffinity": { "requiredDuringSchedulingIgnoredDuringExecution": [ { "labelSelector": { "matchLabels": { "staging/services": "true" } }, "topologyKey": "kubernetes.io/hostname" } ] } },
          "hostNetwork": true,
          "hostAliases": [ { "ip": "10.45.0.1", "hostnames": ["plc.{{zone}}", "pds.{{zone}}", "relay.{{zone}}", "jetstream.{{zone}}"] } ],
          "containers": [
            {
              "name": "pds",
              "image": "ghcr.io/bluesky-social/pds@sha256:8e58b79746da8a0e85698aa7ba9b53e508b94db2021d963653b6d1bfc14889c6",
              "env": [
                { "name": "PDS_PORT", "value": "80" },
                { "name": "PDS_HOSTNAME", "value": "pds.{{zone}}" },
                { "name": "PDS_DEV_MODE", "value": "true" },
                { "name": "PDS_INVITE_REQUIRED", "value": "false" },
                { "name": "PDS_DID_PLC_URL", "value": "http://plc.{{zone}}:2582" },
                { "name": "PDS_CRAWLERS", "value": "http://relay.{{zone}}:2470" },
                { "name": "PDS_DATA_DIRECTORY", "value": "/pds" },
                { "name": "PDS_BLOBSTORE_DISK_LOCATION", "value": "/pds/blocks" },
                { "name": "LOG_ENABLED", "value": "true" },
                { "name": "PDS_ADMIN_PASSWORD", "valueFrom": { "secretKeyRef": { "name": "staging", "key": "pds-admin-password" } } },
                { "name": "PDS_JWT_SECRET", "valueFrom": { "secretKeyRef": { "name": "staging", "key": "pds-jwt-secret" } } },
                { "name": "PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX", "valueFrom": { "secretKeyRef": { "name": "staging", "key": "pds-plc-rotation-key" } } }
              ],
              "readinessProbe": { "httpGet": { "path": "/xrpc/_health", "port": 80 }, "periodSeconds": 5 },
              "volumeMounts": [ { "name": "data", "mountPath": "/pds" } ],
              "resources": { "requests": { "cpu": "250m", "memory": "512Mi" } }
            }
          ],
          "volumes": [ { "name": "data", "emptyDir": {} } ]
        }
      }
    }
  },
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": { "name": "relay", "namespace": "staging" },
    "spec": {
      "replicas": 1,
      "strategy": { "type": "Recreate" },
      "selector": { "matchLabels": { "app": "relay" } },
      "template": {
        "metadata": { "labels": { "app": "relay", "staging/services": "true", "staging/tag": "relay-42946cbf2164b43a0d5782f23dc96069a3552f29" } },
        "spec": {
          "affinity": { "podAffinity": { "requiredDuringSchedulingIgnoredDuringExecution": [ { "labelSelector": { "matchLabels": { "staging/services": "true" } }, "topologyKey": "kubernetes.io/hostname" } ] } },
          "hostNetwork": true,
          "hostAliases": [ { "ip": "10.45.0.1", "hostnames": ["plc.{{zone}}", "pds.{{zone}}", "relay.{{zone}}", "jetstream.{{zone}}"] } ],
          "containers": [
            {
              "name": "relay",
              "image": "ghcr.io/bluesky-social/indigo@sha256:9f43e78e538d4b7014ad6b3829f219f986303aa68a43ceb8f1949bcc111bf52b",
              "env": [
                { "name": "RELAY_API_BIND", "value": ":2470" },
                { "name": "RELAY_PLC_HOST", "value": "http://plc.{{zone}}:2582" },
                { "name": "RELAY_ALLOW_INSECURE_HOSTS", "value": "true" },
                { "name": "RELAY_ADMIN_PASSWORD", "valueFrom": { "secretKeyRef": { "name": "staging", "key": "relay-admin-password" } } }
              ],
              "readinessProbe": { "httpGet": { "path": "/xrpc/_health", "port": 2470 }, "periodSeconds": 5 },
              "volumeMounts": [ { "name": "data", "mountPath": "/data" } ],
              "resources": { "requests": { "cpu": "250m", "memory": "512Mi" } }
            }
          ],
          "volumes": [ { "name": "data", "emptyDir": {} } ]
        }
      }
    }
  },
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": { "name": "jetstream", "namespace": "staging" },
    "spec": {
      "replicas": 1,
      "strategy": { "type": "Recreate" },
      "selector": { "matchLabels": { "app": "jetstream" } },
      "template": {
        "metadata": { "labels": { "app": "jetstream", "staging/services": "true", "staging/tag": "v0.4.4" } },
        "spec": {
          "affinity": { "podAffinity": { "requiredDuringSchedulingIgnoredDuringExecution": [ { "labelSelector": { "matchLabels": { "staging/services": "true" } }, "topologyKey": "kubernetes.io/hostname" } ] } },
          "hostNetwork": true,
          "hostAliases": [ { "ip": "10.45.0.1", "hostnames": ["plc.{{zone}}", "pds.{{zone}}", "relay.{{zone}}", "jetstream.{{zone}}"] } ],
          "containers": [
            {
              "name": "jetstream",
              "image": "ghcr.io/bluesky-social/jetstream@sha256:eeb044f02c32dda3dcf4d8d4ba12981f6c6808fc27135edf9b518adb5cee0b83",
              "args": ["serve"],
              "env": [
                { "name": "JETSTREAM_ADDR", "value": ":6008" },
                { "name": "JETSTREAM_RELAY_URL", "value": "http://relay.{{zone}}:2470" },
                { "name": "JETSTREAM_PLC_URL", "value": "http://plc.{{zone}}:2582" },
                { "name": "JETSTREAM_DATA_DIR", "value": "/data" }
              ],
              "readinessProbe": { "httpGet": { "path": "/xrpc/_health", "port": 6008 }, "periodSeconds": 5 },
              "volumeMounts": [ { "name": "data", "mountPath": "/data" } ],
              "resources": { "requests": { "cpu": "250m", "memory": "1Gi" } }
            }
          ],
          "volumes": [ { "name": "data", "emptyDir": {} } ]
        }
      }
    }
  }
]
