# The gateway VM's piece, appended to the meshd user-data (tests/modules/staging fn user_data): its write_files and
# runcmd gain these entries, after meshd's. The host fills {{...}}; {{password}} lands only in a 0600 file.
packages: [tzdata]
write_files:
- path: /etc/socialweb-staging/atproto.env
  permissions: '0600'
  content: |
    ATPROTO_PASSWORD={{password}}
- path: /usr/local/sbin/swc-staging-gateway
  permissions: '0700'
  content: |
    #!/bin/sh
    # kcp gateway (install gateway, as scripts/deploy.sh), ssh gateway and did:key ingress relay (as prod's
    # swc-ssh-gateway.service and xrpc-relay-server.service), against the staging PLC/PDS/relay/Jetstream.
    set -eu
    A=socialweb
    ST=/var/lib/socialweb-computer/$A
    BIN=/var/lib/socialweb-computer/incoming-{{binarySha256}}
    SPEC=/var/lib/socialweb-computer/gateway-spec-$A.yaml
    GW=gateway.{{zone}}
    INGRESS=$GW:8790
    RELAY=$(printf %s '{{relayUrl}}' | sed -E 's#^[a-z]+://##; s#/.*##')
    # meshd answers REFUSED outside the zone when it has no --dns-upstream; glibc then asks the next server
    grep -q '^nameserver 127.0.0.53' /etc/resolv.conf || echo 'nameserver 127.0.0.53' >> /etc/resolv.conf
    up() { n=0; until curl -fsS -o /dev/null "$1"; do n=$((n+1)); [ $n -lt 360 ] || { echo "not up in 30 min: $1"; exit 1; }; sleep 5; done; }
    up '{{plcUrl}}/_health'
    up '{{pdsUrl}}/xrpc/_health'
    install -d -m 0755 /var/lib/socialweb-computer
    curl -fsSL --retry 5 -o "$BIN.partial" '{{binaryUrl}}'
    echo "{{binarySha256}}  $BIN.partial" | sha256sum -c -
    chmod 0755 "$BIN.partial"
    mv "$BIN.partial" "$BIN"
    # the account exists before install (--adopt-account), so gateway.env is its own 0600 file before the first start
    id -u $A >/dev/null 2>&1 || useradd --system --user-group --no-create-home --home-dir $ST --shell /usr/sbin/nologin --comment socialweb-computer $A
    install -d -m 0700 -o $A -g $A $ST
    { cat /etc/socialweb-staging/atproto.env; echo "SOCIALWEB_GATEWAY_AUDIENCES=did:web:$GW"; } > $ST/gateway.env
    chown $A:$A $ST/gateway.env
    chmod 0600 $ST/gateway.env
    cat > "$SPEC" <<EOF
    network:
      plcDirectoryUrl: "{{plcUrl}}"
      ingressProxyHost: "$INGRESS"
      hosts:
      - name: relay.default.relay.svc.kcp.local
        address: "$RELAY"
    identity:
      mode: pdsAccount
      handle: "{{handle}}"
      pdsUrl: "{{pdsUrl}}"
    comms:
      mode: Firehose
      jetstreamUrls: ["{{jetstreamUrl}}"]
    webAppFront: "0.0.0.0:8788"
    EOF
    chmod 0644 "$SPEC"
    "$BIN" install gateway --account $A --state-dir $ST --adopt-account --host-backend systemd-user \
      --kcp-front-address 127.0.0.1:6443 --tls-front-address 127.0.0.1:8443 --cert-front-address 127.0.0.1:8444 \
      --gateway-spec-file "$SPEC"
    cat > /etc/systemd/system/swc-ingress-relay.service <<EOF
    [Unit]
    Description=did:key xrpc ingress relay (staging; prod: xrpc-relay-server.service on fedproxy.com)
    [Service]
    User=$A
    ExecStart=$ST/bin/current/socialweb-computer internal ingress-relay --listen 0.0.0.0:8790 --hostname $GW --ingress-relay-plc-url {{plcUrl}}
    Restart=always
    RestartSec=5
    [Install]
    WantedBy=multi-user.target
    EOF
    cat > /etc/systemd/system/swc-ssh-gateway.service <<EOF
    [Unit]
    Description=socialweb-computer ssh gateway (staging; prod: swc-ssh-gateway.service, run gateway ssh --instance sg)
    [Service]
    User=$A
    WorkingDirectory=$ST
    ExecStart=$ST/bin/current/socialweb-computer run gateway ssh --instance sg --state-dir $ST/sg --host-backend proc --fg -- --plc-directory-url {{plcUrl}} --ingress-proxy-host $INGRESS --network-hosts relay.default.relay.svc.kcp.local=$RELAY --comms-mode Firehose --ssh-public-listen 0.0.0.0:2222 --ssh-web-listen 0.0.0.0:8789
    Restart=always
    RestartSec=5
    [Install]
    WantedBy=multi-user.target
    EOF
    systemctl daemon-reload
    systemctl enable --now swc-ingress-relay.service swc-ssh-gateway.service
runcmd:
- [sh, -c, "/usr/local/sbin/swc-staging-gateway > /var/log/swc-staging-gateway.log 2>&1"]
